# Copy to .env and fill in. Never commit .env.
APP_ENV=development
PORT=8080

# PostgreSQL 15+
DATABASE_URL=postgres://pacebook:pacebook@localhost:5432/pacebook?sslmode=disable

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# At least 32 random characters in production: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Where the React app runs; used for CORS and post-login redirects.
FRONTEND_URL=http://localhost:5173
# Optional extra allowed origins, comma-separated (never "*").
CORS_ALLOWED_ORIGINS=

# Development only: enables "Development sign-in" without Google.
# Refused when APP_ENV=production.
DEV_AUTH_ENABLED=false

# Optional: serve the built frontend (frontend/dist) from the API server.
STATIC_DIR=

# Contact email shown on /privacy and /terms (used at frontend build time).
VITE_CONTACT_EMAIL=

# Optional: Google Search Console verification token (meta-tag method).
VITE_GOOGLE_SITE_VERIFICATION=
